<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ragplatform</groupId>
    <artifactId>rag-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rag-platform</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Dependency direction (enforced by module dependencies):
         domain <- agent <- application <- impl <- {api-service, ingestion-service} -->
    <modules>
        <module>rag-domain</module>
        <module>rag-agent</module>
        <module>rag-application</module>
        <module>rag-impl</module>
        <module>rag-api-service</module>
        <module>rag-ingestion-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.ragplatform</groupId><artifactId>rag-domain</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.ragplatform</groupId><artifactId>rag-agent</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.ragplatform</groupId><artifactId>rag-application</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.ragplatform</groupId><artifactId>rag-impl</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>
</project>
