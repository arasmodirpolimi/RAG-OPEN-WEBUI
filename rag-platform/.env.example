# Copy to .env and change the two keys.
RAG_OPENAI_API_KEY=change-me-long-random-string
RAG_ADMIN_API_KEY=change-me-another-long-random-string

# Knowledge bases; each becomes a model "rag-<name>" in Open WebUI.
RAG_COLLECTIONS=contratti,normativa

# Local models (Ollama). On machines with < 16 GB RAM try CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3
CHAT_MODEL=qwen2.5:7b

# Use Claude instead of the local chat model (document excerpts are then sent to the Claude API):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Apple Silicon / ARM hosts: use the arm64 TEI image
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
RERANK_MODEL=Alibaba-NLP/gte-multilingual-reranker-base

POSTGRES_PASSWORD=rag
RABBITMQ_PASSWORD=rag
